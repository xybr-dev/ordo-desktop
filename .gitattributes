# The shaping-probe fixture is byte-compared against in-memory `writeln!`
# output (LF) on Linux and Windows alike; a CRLF checkout would fail the
# comparison without any shaping drift.
crates/rendering/tests/fixtures/shaping-probe.txt text eol=lf
# Golden corpus fixtures and goldens are byte-compared against in-memory
# `writeln!` output on Linux and Windows alike; a CRLF checkout would fail
# the comparison without any composition drift.
tests/fixtures/rendering/*.txt text eol=lf
tests/golden-frames/*.txt text eol=lf
# The packaged invariance golden is byte-compared against in-memory `writeln!`
# output (LF) on Linux and Windows alike; a CRLF checkout would fail the
# comparison without any composition drift.
tests/native-runtime/golden/*.txt text eol=lf
# `ui::tokens` tests `include_str!` DESIGN.md and parse its frontmatter by
# `---\n`; a CRLF checkout would fail them without any token drift.
DESIGN.md text eol=lf
# The roadmap is edited as LF; a CRLF working copy would commit whole-file churn.
MILESTONES.md text eol=lf
# `adr.py` writes records and the index as LF; a CRLF working copy would commit
# whole-file churn the next time it regenerates them.
docs/decisions/** text eol=lf
# Vendored mockup files stay byte-identical to upstream on every checkout.
docs/mockups/vendor/** -text
# Presentation snapshot fixtures are LF-only text and are SHA-256 hashed byte
# for byte: frames and assets by the manifest's per-file digests, and the
# manifest itself by the hash the E2E test pins. A CRLF checkout would break
# those digests and the reader rejects carriage returns outright.
tests/fixtures/presentations/** -text
# Migration checksums are SHA-256 over the exact SQL bytes; a CRLF checkout
# would give a Windows build different checksums from a Linux build.
migrations/*.sql text eol=lf
# ERD.md is byte-compared against the in-memory render; a CRLF checkout would drift.
ERD.md text eol=lf
