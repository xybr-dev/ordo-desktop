{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordo.invalid/contracts/snapshot-manifest/v1.schema.json",
  "title": "Presentation snapshot manifest v1",
  "description": "Immutable captured version of one Mass plan. assets_fingerprint is the SHA-256 of every assets[].sha256 sorted, each followed by LF. Each item asset_ids entry must name an asset of this snapshot. Asset bytes live in the container under assets/; sha256 is checked by the container layer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "assets_fingerprint",
    "id",
    "items",
    "mass_plan_id",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Payload contract version; 1 in v1."
    },
    "id": {
      "$ref": "#/$defs/uuid",
      "description": "Stable UUIDv4 of this snapshot manifest."
    },
    "mass_plan_id": {
      "$ref": "#/$defs/uuid",
      "description": "UUID of the Mass plan this snapshot captures."
    },
    "celebration_id": {
      "$ref": "#/$defs/uuid",
      "description": "UUID of the Celebration the Mass plan belongs to."
    },
    "captured_at": {
      "$ref": "#/$defs/timestamp",
      "description": "UTC time the snapshot was captured."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Captured Mass items in order; at least one."
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/asset"
      },
      "description": "Assets referenced by the items, each with exact byte size and SHA-256."
    },
    "assets_fingerprint": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 fingerprint over the listed assets."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Lowercase hyphenated UUIDv4."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 of exact bytes."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC 3339 UTC timestamp without fraction."
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/(?!(?:[^/]*/)*\\.{1,2}(?:/|$))(?:[^/\\\\\\u0000]+/)*[^/\\\\\\u0000]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ids",
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "asset_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    }
  }
}
