{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordo.invalid/contracts/parish-backup/v1.schema.json",
  "title": "Parish Backup v1",
  "description": "Complete portable snapshot of one Parish scope. assets_fingerprint is the SHA-256 of database.sha256 and every assets[].sha256, sorted, each followed by LF. The database bytes are verified by the container layer against database.sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "assets_fingerprint",
    "created_at",
    "database",
    "id",
    "parish",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Payload contract version; 1 in v1."
    },
    "id": {
      "$ref": "#/$defs/uuid",
      "description": "Stable UUIDv4 of this Parish Backup."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp",
      "description": "UTC time the Parish Backup was created."
    },
    "parish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "logo_asset_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "description": "The Parish the backup belongs to: its id and name."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_version",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^database/(?!(?:[^/]*/)*\\.{1,2}(?:/|$))(?:[^/\\\\\\u0000]+/)*[^/\\\\\\u0000]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The Parish database captured in the backup: path, schema version, size, and SHA-256."
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/asset"
      },
      "description": "Assets stored with the backup, each with exact byte size and SHA-256."
    },
    "assets_fingerprint": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 fingerprint over the listed assets."
    },
    "package_provenance": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "package_version_id"
        ],
        "properties": {
          "package_version_id": {
            "$ref": "#/$defs/uuid"
          },
          "fingerprint": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "description": "Installed Celebration Packages at backup time, kept for Library reconciliation."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Lowercase hyphenated UUIDv4."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 of exact bytes."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC 3339 UTC timestamp without fraction."
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/(?!(?:[^/]*/)*\\.{1,2}(?:/|$))(?:[^/\\\\\\u0000]+/)*[^/\\\\\\u0000]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
