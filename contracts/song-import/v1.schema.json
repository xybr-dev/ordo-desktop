{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordo.invalid/contracts/song-import/v1.schema.json",
  "title": "Song import document v1",
  "description": "One Song work with its Arrangements, carried as the song-import kind of an .ordo file. Arrangement content_sha256 is the SHA-256 of every slide line in slide order, each followed by LF. Each sequence entry names a slide of the same Arrangement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "arrangements",
    "id",
    "schema_version",
    "title"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Payload contract version; 1 in v1."
    },
    "id": {
      "$ref": "#/$defs/uuid",
      "description": "Stable UUIDv4 of this Song import document."
    },
    "title": {
      "$ref": "#/$defs/text",
      "description": "Title of the Song work."
    },
    "aliases": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/text"
      },
      "description": "Alternative titles for the Song work."
    },
    "composer": {
      "$ref": "#/$defs/text",
      "description": "Composer credited for the Song work."
    },
    "source": {
      "$ref": "#/$defs/text",
      "description": "Where the Song work was obtained, as named by the importer."
    },
    "language": {
      "$ref": "#/$defs/text",
      "description": "Primary language of the Song work."
    },
    "arrangements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arrangement"
      },
      "description": "Arrangements of the Song work; at least one."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Lowercase hyphenated UUIDv4."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 of exact bytes."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "arrangement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "id",
        "name",
        "sequence",
        "slides"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "language": {
          "$ref": "#/$defs/text"
        },
        "choirs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "occasions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slide"
          }
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
